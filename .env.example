# Copy to .env and fill in. NEVER commit .env.
DJANGO_SECRET_KEY=change-me-long-random
DJANGO_DEBUG=0
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
DOMAIN=yourdomain.com
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
DATABASE_URL=postgres://mx:mxpass@db:5432/mx
POSTGRES_PASSWORD=mxpass
REDIS_URL=redis://redis:6379/0
# Real orders stay OFF until you deliberately set this to 1
ALLOW_LIVE_TRADING=0
MAX_LOTS_PER_RUN=2
NIFTY_EXPIRY_WEEKDAY=1
BREEZE_LOT_SIZE=65
